<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="localmail.exe"
        Arguments=""
        InstallLocation="C:\Program Files\LocalMail\LocalMail">
    </Installer>
    <PackageInformation
        PackageName="LocalMail"
        PackageDisplayName="LocalMail"
        PublisherName="CN=LocalMail"
        PublisherDisplayName="LocalMail"
        Version="0.1.0.0"
        PackageDescription="Local SMTP email testing tool">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.localmail.app"
                Description="Local SMTP email testing tool"
                DisplayName="LocalMail"
                ExecutableName="localmail.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>LocalMail</DisplayName>
            <PublisherDisplayName>LocalMail</PublisherDisplayName>
            <Description>Local SMTP email testing tool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="localmail.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
